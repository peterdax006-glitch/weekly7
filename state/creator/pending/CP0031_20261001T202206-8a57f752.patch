+def test_the_efficiency_kind_is_a_measured_design_decision(cfg: K.KernelConfig) -> None:
+    """K08 integrated: SIZE vs ACTIVATION is chosen by creator.design on measured benefit and risk, the loser kept with a reason."""
+    from creator import planner as P
+    put(cfg.repo, "creator/kernel.py", "from creator import big\n\n\ndef start():\n    return big.add(1, 2)\n")
+    led = Ledger(cfg.ledger_path, evidence_root=cfg.repo)
+    kind, note = P.choose_efficiency_kind(led, cfg.repo)
+    assert kind in ("size", "activation") and note.startswith(f"design decision: {kind}") and "scored" in note
+    other = "activation" if kind == "size" else "size"
+    assert other in note                                                 # the rejected alternative is kept with its reason
