+def choose_efficiency_kind(ledger: Ledger, root: Any, window: int = 10) -> tuple[str, str]:
+    """K08 in the loop: SIZE or ACTIVATION is a design decision made with creator.design - two options scored on measured
+    benefit (how much there is to gain), risk (how often recent packages of that kind failed) and cost, the loser kept with its
+    reason. Returns (kind, a one-line record of the decision for the work package)."""
+    from pathlib import Path as _P
+    from creator import design as DS
+    from creator import efficiency as E
+    rootp = _P(root)
+    if not (rootp / "creator" / "kernel.py").is_file():
+        return "size", "design decision: size (no kernel entry point here, so activation cannot be measured)"
+    act = E.activation(rootp)
+    sizes = {f: n for f, n in E.sizes(rootp).items() if E.editable(f)}
+    package = max(1, act["package_nodes"])
+
+    def risk(prefix: str) -> float:
+        recent = [e for e in ledger.of_type("WorkPackage") if getattr(e.record, "objective", "").startswith(prefix)][-window:]
+        failed = sum(1 for e in recent if ledger.view.status.get(e.id) is M.Status.FAILED)
+        return (failed + 1) / (len(recent) + 2)                       # Laplace: unknown -> 0.5
+    options = DS.generate_options("which efficiency work next?", [
+        {"name": "size", "summary": "shrink the largest module the Creator may edit", "assumptions": ("behaviour kept by tests",),
+         "failure_modes": ("no rule applies", "a requirement is lost"), "cost": 0.5, "risk": risk("shrink "),
+         "benefit": min(1.0, 4.0 * max(sizes.values(), default=0) / package)},
+        {"name": "activation", "summary": "load less code when the Creator starts", "assumptions": ("imports used only in functions",),
+         "failure_modes": ("an import needed at module level", "no loaded module can defer"), "cost": 0.5,
+         "risk": risk("load less"), "benefit": float(act["fraction"])},
+    ], n=2)
+    decision = DS.select("which efficiency work next?", options)
+    assert decision.selected is not None
+    note = (f"design decision: {decision.selected.name} (score {decision.scores[decision.selected.name]:.3f}) over "
+            + "; ".join(f"{o.name} {r}" for o, r in decision.rejected))
+    return decision.selected.name, note
+
+
