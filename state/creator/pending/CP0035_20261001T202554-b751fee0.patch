+def memory_path(ledger: Ledger) -> Path:
+    return Path(ledger.path).parent / "dev_memory.jsonl"
+
+
+def remembered(ledger: Ledger, query: str, limit: int = 3, subject: str = "") -> list[str]:
+    """K12 in the loop: what development memory has seen like this before (past failures and repairs), for the work package.
+    The same subject (requirement + component + step) first, most recent first; then token similarity (Jaccard punishes long
+    details, so it is only the fallback)."""
+    from creator import memory as MEM                                   # loaded only when a package is being planned
+    mem = MEM.load(memory_path(ledger))
+    exact = [e for e in reversed(mem.entries) if subject and e.subject == subject][:limit]
+    similar = [e for _, e in mem.seen_before(query, limit=limit, min_score=0.25) if e not in exact]
+    return [f"{e.kind} {e.subject}: {e.detail[:160]}" for e in (exact + similar)[:limit]]
+
+
