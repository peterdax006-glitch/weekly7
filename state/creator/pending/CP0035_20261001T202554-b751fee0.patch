+def test_development_memory_reaches_the_next_work_package(world) -> None:
+    """K12 integrated: an outcome the kernel remembered is retrieved into the next package for the same requirement."""
+    from creator import memory as MEM
+    led, model = world
+    first = P.plan_next(led, model, "b", SPECS, steps=("exists",))
+    assert first is not None and "remembered" not in led.get(first.work_package_id).why_it_exists
+    MEM.append(P.memory_path(led), "failure", f"{first.requirement_key} {first.component} {first.step}",
+               "rejected: the new module had no test that reaches it", ("exists", "REJECTED"))
+    P.record_outcome(led, first, False, "no test reached it")
+    second = P.plan_next(led, model, "b", SPECS, steps=("exists",))
+    assert second is not None and second.gap_id == first.gap_id
+    assert "remembered: failure" in led.get(second.work_package_id).why_it_exists
+    assert "no test that reaches it" in led.get(second.work_package_id).why_it_exists
+
