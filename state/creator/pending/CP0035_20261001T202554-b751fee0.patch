+def append(path, kind: str, subject: str, detail: str = "", tags=()) -> MemoryEntry:
+    """Remember one entry by APPENDING a single line (safe when several workers write at once - Memory.save rewrites the file)."""
+    entry = Memory().remember(kind, subject, detail, tags)
+    p = Path(path)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with p.open("a", encoding="utf-8") as f:
+        f.write(json.dumps(entry.to_dict(), sort_keys=True) + "\n")
+    return entry
+
+
