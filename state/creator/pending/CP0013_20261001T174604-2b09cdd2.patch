         done: list[str] = []
+        pc = problem_class(plan)
+        order = [r for r in self.learner.order(pc) if r in self.rules] if self.learner else list(self.rules)
+        self.tried = order
         for rel in self.targets(plan, package):
             p = workdir / rel
             if not p.is_file():
                 continue
-            for rule in self.rules:
+            for rule in order:
+                applied = False
                 for _ in range(self.max_rounds):                    # apply a rule repeatedly while it keeps passing
                     src = p.read_text(encoding="utf-8")
                     if rule == "unused_imports":
@@ -197,6 +246,9 @@ class RuleWorker:
                         p.write_text(src, encoding="utf-8")         # this application broke something: undo, try next rule
                         break
                     done.append(f"{rule}:{rel}")
+                    applied = True
+                if self.learner is not None:
