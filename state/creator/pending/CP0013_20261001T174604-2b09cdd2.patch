+def test_meta_learning_orders_the_rules_and_learns_across_runs(tmp_path: Path) -> None:
+    """K13 integrated: the RuleWorker asks creator.meta which rule to try first, and every application teaches it."""
+    log = tmp_path / "rule_outcomes.jsonl"
+    learner = SW.RuleLearner(log)
+    assert learner.order("EFF.size")[0] == "unused_imports"                       # untried rules first, registration order
+    for _ in range(4):
+        learner.record("unused_imports", "EFF.size", False)
+        learner.record("lazy_imports", "EFF.size", False)
+        learner.record("dead_private", "EFF.size", True)
+    again = SW.RuleLearner(log)                                                  # a new run reloads what was learned
+    assert again.order("EFF.size")[0] == "dead_private"
+    assert again.order("EFF.activation")[0] == "unused_imports"                    # learning is per kind of package
+
+
+def test_the_rule_worker_uses_and_feeds_the_learner(tmp_path: Path) -> None:
+    r = tmp_path / "w"
+    put(r, "creator/__init__.py", "")
+    put(r, "creator/x.py", "import os\n\n\ndef _dead():\n    return 1\n\n\ndef f():\n    return 2\n")
+    put(r, "tests/__init__.py", "")
+    put(r, "tests/test_x.py", "from creator.x import f\n\n\ndef test_f():\n    assert f() == 2\n")
+    subprocess.run(["git", "init", "-q"], cwd=r)
+    learner = SW.RuleLearner(tmp_path / "log.jsonl")
+    for _ in range(3):
+        learner.record("dead_private", "EFF.size", True)
+        learner.record("unused_imports", "EFF.size", False)
+        learner.record("lazy_imports", "EFF.size", False)
+    worker = SW.RuleWorker(learner=learner)
+    plan = P.Plan("g", P.EFFICIENCY_KEY, "creator/x.py", "efficiency", None, "wp", "CP1", "cp", "ex", 1)
+
+    class Pkg:
+        outputs = ("creator/x.py",)
+    res = worker(plan, Pkg(), r)
+    assert res.claimed_done and worker.tried[0] == "dead_private"                 # the learned order was used
+    text = (r / "creator/x.py").read_text(encoding="utf-8")
+    assert "_dead" not in text and "import os" not in text
+    assert learner.ml.stats("unused_imports", "EFF.size")["n"] == 4               # and the outcome was recorded
