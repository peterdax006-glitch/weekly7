 RULES: tuple[str, ...] = ("unused_imports", "lazy_imports", "dead_private")
 
 
+class RuleLearner:
+    """K13 meta-learning applied to the system's own rules: which rule to try first for which kind of package. Each rule is a
+    creator.meta Strategy; every application is an Outcome (success = applied and the tests that reach it pass), persisted to an
+    append-only log so the order keeps learning across runs. Ordering: MetaLearner.select (UCB1: untried first, then the best
+    success rate plus an exploration bonus) picks the first rule, the rest follow by success rate."""
+
+    def __init__(self, log: Optional[Path] = None, rules: Sequence[str] = RULES) -> None:
+        import json
+        from creator import meta as MT
+        self.log = log
+        self.ml = MT.MetaLearner()
+        for r in rules:
+            self.ml.register(MT.Strategy(name=r, agent=SELF_PREFIX + "rules"))
+        if log is not None and log.is_file():
+            for ln in log.read_text(encoding="utf-8").splitlines():
+                try:
+                    row = json.loads(ln)
+                    if row.get("rule") in self.ml.strategies:
+                        self.ml.record(row["rule"], row["problem_class"], bool(row["success"]))
+                except (ValueError, KeyError):
+                    continue
+
+    def order(self, problem_class: str) -> list[str]:
+        first = self.ml.select(problem_class).name
+        rest = [r for r in self.ml.strategies if r != first]
+        rate = {r: self.ml.stats(r, problem_class)["success_rate"] for r in rest}
+        return [first] + sorted(rest, key=lambda r: -(rate[r] if rate[r] is not None else 0.5))
+
+    def record(self, rule: str, problem_class: str, success: bool) -> None:
+        import json
+        self.ml.record(rule, problem_class, success)
+        if self.log is not None:
+            self.log.parent.mkdir(parents=True, exist_ok=True)
+            with self.log.open("a", encoding="utf-8") as fh:
+                fh.write(json.dumps({"rule": rule, "problem_class": problem_class, "success": success}) + "\n")
+
+
+def problem_class(plan: Optional[P.Plan]) -> str:
+    if plan is None:
+        return "unknown"
+    return plan.requirement_key if plan.step == "efficiency" else plan.step
+
+
